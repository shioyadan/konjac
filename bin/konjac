#!/bin/sh

set -eu

usage() {
    cat >&2 <<'EOF'
Usage: konjac <command> [options] <pdf-file> [output]
       konjac import [options] <pdf-file> <translation-json> [output]

Commands:
  html              Generate HTML (default: <pdf-name>.html)
  json              Generate extraction JSON (default: <pdf-name>.json)
  extract-json      Alias for json
  translation-json  Generate translation JSON (default: <pdf-name>.translation.json)
  import            Import translation JSON and generate HTML

Options:
  -o, --output <file>       Write to <file>; use - for standard output
  -f, --force               Overwrite an existing output file
      --password <password> PDF password (or use KONJAC_PDF_PASSWORD)
      --debug-mask <dir>    Write page mask SVG files
      --debug-scan <text>   Write scan diagnostics for a caption to stderr
  -h, --help                Show this help

Examples:
  bin/konjac html paper.pdf
  bin/konjac translation-json paper.pdf translations/paper.json
  bin/konjac import paper.pdf translations/paper.json paper.ja.html
  bin/konjac json --debug-mask /tmp/paper-mask paper.pdf -
EOF
}

fail() {
    printf 'konjac: %s\n' "$1" >&2
    exit 2
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
invocation_dir=$(pwd)
if [ -f "$script_dir/cli.cjs" ] && [ -f "$script_dir/../../package.json" ]; then
    project_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
    cli_file=$script_dir/cli.cjs
elif [ -f "$script_dir/../package.json" ]; then
    project_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
    cli_file=$project_dir/dist/cli/cli.cjs
else
    fail "cannot locate the Konjac project directory"
fi

if [ $# -eq 0 ]; then
    usage
    exit 2
fi

command_name=$1
shift
translation_required=0
case "$command_name" in
    html)
        cli_mode=--html
        output_suffix=.html
        ;;
    json|extract-json)
        cli_mode=--json
        output_suffix=.json
        ;;
    translation-json)
        cli_mode=--translation-json
        output_suffix=.translation.json
        ;;
    import|import-translation)
        cli_mode=--import-translation
        output_suffix=.translated.html
        translation_required=1
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        fail "unknown command: $command_name"
        ;;
esac

force=0
output=
password=
password_set=0
debug_mask=
debug_scan=
pdf_file=
translation_file=

assign_argument() {
    if [ -z "$pdf_file" ]; then
        pdf_file=$1
    elif [ "$translation_required" -eq 1 ] && [ -z "$translation_file" ]; then
        translation_file=$1
    elif [ -z "$output" ]; then
        output=$1
    else
        fail "too many arguments"
    fi
}

while [ $# -gt 0 ]; do
    case "$1" in
        -o|--output)
            [ $# -ge 2 ] || fail "$1 requires a file"
            [ -z "$output" ] || fail "output was specified more than once"
            output=$2
            shift 2
            ;;
        --output=*)
            [ -z "$output" ] || fail "output was specified more than once"
            output=${1#*=}
            [ -n "$output" ] || fail "--output requires a file"
            shift
            ;;
        -f|--force)
            force=1
            shift
            ;;
        --password)
            [ $# -ge 2 ] || fail "--password requires a value"
            password=$2
            password_set=1
            shift 2
            ;;
        --password=*)
            password=${1#*=}
            password_set=1
            shift
            ;;
        --debug-mask)
            [ $# -ge 2 ] || fail "--debug-mask requires a directory"
            debug_mask=$2
            shift 2
            ;;
        --debug-mask=*)
            debug_mask=${1#*=}
            [ -n "$debug_mask" ] || fail "--debug-mask requires a directory"
            shift
            ;;
        --debug-scan)
            [ $# -ge 2 ] || fail "--debug-scan requires caption text"
            debug_scan=$2
            shift 2
            ;;
        --debug-scan=*)
            debug_scan=${1#*=}
            [ -n "$debug_scan" ] || fail "--debug-scan requires caption text"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -)
            [ -n "$pdf_file" ] || fail "standard input is not supported for PDF files"
            if [ "$translation_required" -eq 1 ] && [ -z "$translation_file" ]; then
                fail "a translation JSON file is required before the output"
            fi
            [ -z "$output" ] || fail "output was specified more than once"
            output=-
            shift
            ;;
        -*)
            fail "unknown option: $1"
            ;;
        *)
            assign_argument "$1"
            shift
            ;;
    esac
done

while [ $# -gt 0 ]; do
    assign_argument "$1"
    shift
done

[ -n "$pdf_file" ] || fail "a PDF file is required"
[ -f "$pdf_file" ] || fail "PDF file not found: $pdf_file"
if [ "$translation_required" -eq 1 ]; then
    [ -n "$translation_file" ] || fail "a translation JSON file is required"
    [ -f "$translation_file" ] || fail "translation JSON file not found: $translation_file"
fi

if [ -z "$output" ]; then
    pdf_dir=$(dirname -- "$pdf_file")
    pdf_name=$(basename -- "$pdf_file")
    case "$pdf_name" in
        *.*) pdf_stem=${pdf_name%.*} ;;
        *) pdf_stem=$pdf_name ;;
    esac
    output=$pdf_dir/$pdf_stem$output_suffix
fi

case "$pdf_file" in
    /*) pdf_argument=$pdf_file ;;
    *) pdf_argument=$invocation_dir/$pdf_file ;;
esac
case "$debug_mask" in
    ""|/*) ;;
    *) debug_mask=$invocation_dir/$debug_mask ;;
esac
case "$translation_file" in
    ""|/*) translation_argument=$translation_file ;;
    *) translation_argument=$invocation_dir/$translation_file ;;
esac

if [ ! -f "$cli_file" ]; then
    command -v make >/dev/null 2>&1 || fail "CLI is not built and make is unavailable"
    (cd "$project_dir" && make cli-build) || exit $?
fi

node_command=${KONJAC_NODE:-node}
command -v "$node_command" >/dev/null 2>&1 || fail "Node.js executable not found: $node_command"

set -- "$cli_mode"
if [ "$translation_required" -eq 1 ]; then
    set -- "$@" "$translation_argument"
fi
if [ "$password_set" -eq 1 ]; then
    set -- "$@" --password "$password"
fi
if [ -n "$debug_mask" ]; then
    set -- "$@" --debug-mask "$debug_mask"
fi
if [ -n "$debug_scan" ]; then
    set -- "$@" --debug-scan "$debug_scan"
fi
set -- "$@" "$pdf_argument"

if [ "$output" = - ]; then
    (cd "$project_dir" && exec "$node_command" "$cli_file" "$@")
    exit $?
fi

if [ -e "$output" ] && [ "$force" -ne 1 ]; then
    fail "output already exists (use --force to overwrite): $output"
fi

output_dir=$(dirname -- "$output")
mkdir -p -- "$output_dir"
temporary_output=$(mktemp "$output_dir/.konjac.XXXXXX")
trap 'rm -f -- "$temporary_output"' EXIT HUP INT TERM

(cd "$project_dir" && "$node_command" "$cli_file" "$@") > "$temporary_output"
mv -f -- "$temporary_output" "$output"
trap - EXIT HUP INT TERM
printf '%s\n' "$output"
